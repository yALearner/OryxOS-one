<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.oryxos</groupId>
        <artifactId>oryxos</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>oryxos-boot</artifactId>
    <name>OryxOS :: Boot</name>
    <description>Spring Boot 启动模块：主类、自动配置、依赖聚合</description>

    <dependencies>
        <!-- Internal (aggregates all modules for classpath scanning) -->
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-cli</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-channel-cli</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-provider</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-tool</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-storage</artifactId>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Spring Boot Test (for testing support) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
